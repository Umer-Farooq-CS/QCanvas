# ## QCanvas (Docker Compose) - example environment
# #
# # Copy to `.env` (do not commit `.env`) and adjust values as needed.
# #
# # The frontend stays local and should keep:
# #   NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# #
# # The backend container connects to Postgres/Redis via Compose DNS names.

# # --- Postgres (service: postgres) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=qcanvas_db

# # These are used by backend/app/config/settings.py to build DATABASE_URL
# POSTGRES_SERVER=postgres
# POSTGRES_PORT=5432

# # --- Redis (service: redis) ---
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0

# # --- Security ---
# # Change this in real deployments.
# SECRET_KEY=development_secret_key
# FRONTEND_URL=http://localhost:3000
# MASTER_ADMIN_EMAIL=muhammadirtazakhan2004@gmail.com

# # Optional: override full URLs directly if you prefer (takes precedence if app uses it)
# # DATABASE_URL=postgresql://postgres:postgres@postgres:5432/qcanvas_db
# # REDIS_URL=redis://redis:6379/0

# # FastQSim Online Mode Configuration
# FASTQSIM_ONLINE_MODE=false
# FASTQUBIT_USER_ID=12345678
# FASTQSIM_API_TOKEN=your_token_here
# FASTQUBIT_ENDPOINT=https://fastqubit.dev/api
# FASTQSIM_EXECUTION_MODE=cloud

#OTP Setup
AUTH_EMAIL_OTP_ENABLED=
OTP_PEPPER=
RESEND_API_KEY=

CIRQ_RAG_API_KEY=


#Email provider setup
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_PROVIDER=
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
RESEND_API_BASE_URL=

FRONTEND_URL=http://localhost:3000
MASTER_ADMIN_EMAIL=

# FastQSim Online Mode Configuration
FASTQSIM_ONLINE_MODE=true
FASTQUBIT_USER_ID=
FASTQSIM_API_TOKEN=
FASTQUBIT_ENDPOINT=https://fastqubit.dev/api
FASTQSIM_EXECUTION_MODE=cloud

